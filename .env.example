# Copy to .env and fill in. auditsift reads .env from the working directory
# without overriding variables that are already set.
ATMOROUTER_API_KEY=ar-your-key-here

# Optional. Defaults are an OpenAI-compatible AtmoRouter gateway and two
# different models: a triage model, then a cheaper verify model.
# AUDITSIFT_API_KEY=
# AUDITSIFT_BASE_URL=https://atmorouter.dev/v1
# AUDITSIFT_TRIAGE_MODEL=openai/gpt-4o-mini
# AUDITSIFT_VERIFY_MODEL=openai/gpt-4.1-nano
# AUDITSIFT_API_STYLE=openai
# AUDITSIFT_TIMEOUT=45
